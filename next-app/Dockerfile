FROM node:20-alpine AS deps
WORKDIR /app

COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_HOST
ARG NEXT_PUBLIC_BILLING_HOST
ARG NEXT_PUBLIC_TENANT_HOST_BASE
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_HOST=${NEXT_PUBLIC_SITE_HOST}
ENV NEXT_PUBLIC_BILLING_HOST=${NEXT_PUBLIC_BILLING_HOST}
ENV NEXT_PUBLIC_TENANT_HOST_BASE=${NEXT_PUBLIC_TENANT_HOST_BASE}
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build args must be re-declared in this stage.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_HOST
ARG NEXT_PUBLIC_BILLING_HOST
ARG NEXT_PUBLIC_TENANT_HOST_BASE

# Runtime env (used by server components and API client)
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_HOST=${NEXT_PUBLIC_SITE_HOST}
ENV NEXT_PUBLIC_BILLING_HOST=${NEXT_PUBLIC_BILLING_HOST}
ENV NEXT_PUBLIC_TENANT_HOST_BASE=${NEXT_PUBLIC_TENANT_HOST_BASE}

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "run", "start"]

