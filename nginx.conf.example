# Nginx reverse proxy for Next.js frontend + Express API
# Copy to /etc/nginx/sites-available/referral and symlink into sites-enabled.
# Assumes frontend on localhost:3000 and backend on localhost:5000 (Docker Compose).
# Replace certificate paths with your certbot-issued files.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream referral_frontend {
    server 127.0.0.1:3000;
}

upstream referral_backend {
    server 127.0.0.1:5000;
}

# HTTP (needed for ACME challenge). You can redirect to HTTPS after certs exist.
server {
    listen 80;
    server_name refoza.com www.refoza.com *.tenant.refoza.com;

    client_max_body_size 20m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /_next/static/ {
        proxy_pass http://referral_frontend;
        proxy_set_header Host $host;
        proxy_cache_valid 200 30s;
    }

    location /api/ {
        proxy_pass http://referral_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://referral_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS
server {
    listen 443 ssl http2;
    server_name refoza.com www.refoza.com *.tenant.refoza.com;

    ssl_certificate /etc/letsencrypt/live/refoza.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/refoza.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    location /_next/static/ {
        proxy_pass http://referral_frontend;
        proxy_set_header Host $host;
        proxy_cache_valid 200 30s;
    }

    location /api/ {
        proxy_pass http://referral_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://referral_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

