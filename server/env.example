# Core
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-me
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=8
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-me

# Media storage (GCS)
GCS_BUCKET_MEDIA=tenant-media
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/tenant-media
GCS_PROJECT_ID=your-project-id
GCS_KEYFILE=/absolute/path/to/service-account.json
GCS_SIGNED_URL_EXPIRY=3600

# Database (Cloud SQL Postgres)
DB_HOST=<cloudsql-public-ip>
DB_PORT=5432
DB_NAME=referral_prod
DB_USER=referral_app
DB_PASS=replace-me
DB_SSL=true

# Host / client URL composition
HOST_BASE=*.tenant.refoza.com
CLIENT_URL_BASE=https://*.tenant.refoza.com
PUBLIC_SITE_URL=https://refoza.com
CLIENT_PROTOCOL=https
CLIENT_PORT=3000
CORS_DOMAIN_SUFFIX=.tenant.refoza.com

# Email (SendGrid)
SENDGRID_API_KEY=replace-me
SENDGRID_FROM_EMAIL=noreply@tenant.refoza.com

# Billing (Stripe)
STRIPE_SECRET_KEY=replace-me
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://*.tenant.refoza.com/admin/billing
STRIPE_CANCEL_URL=https://*.tenant.refoza.com/admin/billing
STRIPE_PORTAL_RETURN_URL=https://*.tenant.refoza.com/admin/billing
STRIPE_TAX_ENABLED=false

# Free tier / bypass (optional)
FREE_TENANT_SLUG=
FREE_TENANT_NAME=
BILLING_BYPASS_TENANT=

